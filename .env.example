# ===========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ===========================================
# Copy this file to .env and replace every CHANGE_ME value locally.
# NEVER commit .env or real credentials to git.
# ===========================================

# Database Configuration
DATABASE_HOST=CHANGE_ME
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=CHANGE_ME
DATABASE_PASSWORD=CHANGE_ME

# Supabase Configuration
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_JWT_SECRET=CHANGE_ME

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# Server Configuration
PORT=8080
